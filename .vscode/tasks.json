{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: build",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo: test",
            "type": "shell",
            "command": "cargo",
            "args": ["test"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo: clippy",
            "type": "shell",
            "command": "cargo",
            "args": ["clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo: run (debug logging)",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--", "--device-name", "Dev Camera", "--debug"],
            "problemMatcher": ["$rustc"],
            "presentation": { "panel": "dedicated" }
        },
        {
            "label": "docker: build image",
            "type": "shell",
            "command": "docker",
            "args": ["build", "-t", "onvif-media-transcoder:test", "."],
            "problemMatcher": []
        },
        {
            "label": "docker: end-to-end test",
            "type": "shell",
            "command": "scripts/e2e-test.sh",
            "args": ["onvif-media-transcoder:test"],
            "dependsOn": "docker: build image",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated" }
        }
    ]
}
