# ONVIF Media Transcoder configuration.
# Copy to .env (repository root) and adjust. Every variable is optional except
# INPUT_URL in practice: the default points at a public demo stream.

# --- Input ------------------------------------------------------------------
# Any source MediaMTX can pull: HLS (http/https .m3u8), RTSP, RTSPS, RTMP,
# UDP, SRT. Local files are not supported; serve them over HTTP or RTSP.
INPUT_URL=https://demo.unified-streaming.com/k8s/features/stable/video/tears-of-steel/tears-of-steel.ism/.m3u8
# INPUT_URL=rtsp://user:pass@camera.local:554/stream1
# INPUT_URL=https://cdn.example.com/live/index.m3u8?token=abc

# What to do when the input is unreachable at start: warn (default, MediaMTX
# keeps retrying), fail (exit) or skip (no check).
INPUT_CHECK=warn

# --- Output -----------------------------------------------------------------
RTSP_OUTPUT_PORT=8554
RTSP_PATH=/stream
ONVIF_PORT=8080
# WS-Discovery always uses UDP 3702.

# --- Device -----------------------------------------------------------------
DEVICE_NAME=ONVIF-Media-Transcoder

# --- Authentication (change these) -----------------------------------------
# Used for ONVIF (HTTP Basic/Digest and WS-Security) and, unless
# RTSP_AUTH_ENABLED=false, for the RTSP stream and snapshots.
ONVIF_USERNAME=admin
ONVIF_PASSWORD=onvif-rust
RTSP_AUTH_ENABLED=true

# --- Discovery and logging --------------------------------------------------
WS_DISCOVERY_ENABLED=true
# Debug logging prints full requests, including credentials. Development only.
DEBUG_LOGGING=false
# RUST_LOG=onvif_media_transcoder=debug   # fine-grained log filter, overrides DEBUG_LOGGING

# --- Networking -------------------------------------------------------------
# IPv4 address clients should use to reach this container. Auto-detected;
# set it when running without host networking or with several interfaces.
# CONTAINER_IP=192.168.1.50
